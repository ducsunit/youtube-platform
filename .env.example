GEMINI_API_KEY=gemini-api-key
DEEPSEEK_API_KEY=deepseek-api-key

# Gen clip Veo (image-to-video, tab "Gen video" tren UI). Dung chung
# GEMINI_API_KEY; dat GOOGLE_API_KEY neu muon key rieng cho Veo.
# GOOGLE_API_KEY=google-ai-studio-key
VEO_MODEL=veo-3.0-generate-preview

# File JSON chua du lieu kenh. Duong dan tuong doi duoc tinh tu thu muc dang chay.
YOUTUBE_CHANNEL_DATA_FILE=data/channels/youtube_data.json

# Co the doi model ma khong can sua code.
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
GEMINI_REVIEW_MODEL=gemini-3.6-flash
GEMINI_AUDIT_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_AUDIT_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
API_MAX_RETRIES=3
CONSISTENCY_MIN_SCORE=90
CONSISTENCY_MAX_ROUNDS=2
DURATION_TOLERANCE=0.25

# Ghi day du input, prompt, response, checkpoint va loi. Khong ghi API key.
YOUTUBE_PIPELINE_LOG_FILE=runtime/logs/youtube_pipeline.log
YOUTUBE_PIPELINE_LOG_LEVEL=DEBUG
YOUTUBE_PIPELINE_LOG_MAX_BYTES=10485760
YOUTUBE_PIPELINE_LOG_BACKUP_COUNT=5

# Trace rieng cac request, response va du lieu chuyen giao giua cac model.
YOUTUBE_MODEL_CALL_LOG_FILE=runtime/logs/model_pipeline_calls.log
YOUTUBE_MODEL_CALL_LOG_MAX_BYTES=10485760
YOUTUBE_MODEL_CALL_LOG_BACKUP_COUNT=5

# Pipeline latency/QA profile: fast | balanced | max
PIPELINE_QUALITY_MODE=balanced

# Persistent cache for deterministic LLM stages. Creative stages are never cached.
LLM_CACHE_ENABLED=1
LLM_CACHE_DIR=.cache/llm
LLM_CACHE_SCHEMA_VERSION=2
