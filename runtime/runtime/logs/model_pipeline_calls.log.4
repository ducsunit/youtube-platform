SOURCE:
{
  "audience_moment": "Bạn đã dành thời gian chờ đợi, nỗ lực làm một việc hoặc theo đuổi một mục tiêu, nhưng phần thưởng mong đợi không xuất hiện; giống như đứng ở sân ga quen thuộc mà chuyến tàu không đến.",
  "central_emotion": "thất vọng",
  "core_self_insight": "Cảm giác hụt hẫng không nhất thiết cho thấy bạn thiếu ý chí; nó có thể xuất hiện khi kết quả thực tế lệch khỏi phần thưởng mà bạn đã dự đoán.",
  "source_person": "Wolfram Schultz, Peter Dayan và P. Read Montague",
  "source_work": "A Neural Substrate of Prediction and Reward",
  "source_concept": "dự đoán phần thưởng và sai lệch dự đoán phần thưởng",
  "verified_sources": [
    {
      "title": "A Neural Substrate of Prediction and Reward",
      "url": "https://doi.org/10.1126/science.275.5306.1593",
      "supports": "Schultz and colleagues reported dopamine-neuron responses related to reward prediction and prediction error in primates; this is not a complete theory of human motivation."
    },
    {
      "title": "Psychology of Habit",
      "url": "https://doi.org/10.1146/annurev-psych-122414-033417",
      "supports": "Wood and Runger review habits as learned responses shaped by repetition and context, with behavior becoming less dependent on deliberative intention in stable contexts."
    },
    {
      "title": "Holding the Hunger Games Hostage at the Gym: An Evaluation of Temptation Bundling",
      "url": "https://doi.org/10.1287/mnsc.2013.1784",
      "supports": "Milkman and colleagues evaluated pairing an immediately enjoyable activity with a should-do activity as a behavioral intervention; the effect depends on context and adherence."
    },
    {
      "title": "The Effort Paradox: Effort Is Both Costly and Valued",
      "url": "https://doi.org/10.1016/j.tics.2018.01.007",
      "supports": "Inzlicht and colleagues review evidence that effort can be experienced as costly while also being valued in some contexts; effort is not uniformly aversive or rewarding."
    }
  ],
  "allowed_paraphrases": [
    "報酬の予測と予測誤差に関わる神経信号が研究されています",
    "脳は報酬そのものだけでなく、予測とのずれにも反応します",
    "習慣は意志の強さだけでなく、反復と状況の手がかりによって形成されます",
    "環境を変えることは、行動のきっかけを変える方法の一つです",
    "楽しみな行動と取り組むべき行動を組み合わせる設計が検討されています",
    "報酬の置き方を変えることで、行動の始めやすさを調整できます",
    "努力は負担であると同時に、状況によって価値を持つことがあります",
    "難しさを感じることだけで、その行動が無価値だとは言えません"
  ],
  "long_form_revelations": [
    {
      "insight": "Sự thất vọng có thể đến từ khoảng cách giữa phần thưởng được dự đoán và phần thưởng thực tế, chứ không tự động chứng minh rằng mục tiêu đó vô nghĩa hoặc bản thân bạn kém cỏi.",
      "source_anchor": "脳は報酬そのものだけでなく、予測とのずれにも反応します",
      "boundary": "Nghiên cứu này không phải là lý thuyết hoàn chỉnh về động lực của con người và không đủ để kết luận về động lực cá nhân của một người."
    },
    {
      "insight": "Khi một hành vi lặp lại trong cùng bối cảnh, việc bắt đầu có thể phụ thuộc nhiều hơn vào dấu hiệu của môi trường và ít phụ thuộc hơn vào ý định có ý thức ở từng khoảnh khắc.",
      "source_anchor": "習慣は意志の強さだけでなく、反復と状況の手がかりによって形成されます",
      "boundary": "Không khẳng định thói quen luôn tự động hóa sau một số ngày cố định hoặc môi trường có thể giải quyết mọi khó khăn tâm lý."
    },
    {
      "insight": "Nếu phần thưởng tự nhiên đến quá muộn, việc ghép một hoạt động dễ chịu ngay lập tức với hành động cần làm có thể là một cách thiết kế lại điểm bắt đầu của hành vi.",
      "source_anchor": "楽しみな行動と取り組むべき行動を組み合わせる設計が検討されています",
      "boundary": "Hiệu quả phụ thuộc vào bối cảnh và mức độ duy trì; nghiên cứu không bảo đảm phương pháp này có tác dụng giống nhau với mọi người."
    },
    {
      "insight": "Nỗ lực không chỉ là một chi phí cần né tránh; trong một số hoàn cảnh, chính nỗ lực cũng có thể được xem là có giá trị, dù cảm giác tốn sức vẫn tồn tại.",
      "source_anchor": "努力は負担であると同時に、状況によって価値を持つことがあります",
      "boundary": "Không suy ra rằng cứ cố gắng thì sẽ trở nên vui thích, cũng không dùng khái niệm này để gọi người không chọn nỗ lực là lười biếng."
    }
  ],
  "forbidden_attributions": [
    "Không giải thích dopamine chỉ như một chất tạo khoái cảm.",
    "Không dùng nghiên cứu về neuron dopamine ở linh trưởng để khẳng định chắc chắn động lực, thói quen hoặc lựa chọn của một cá nhân.",
    "Không khẳng định phần thưởng bị trì hoãn luôn làm mất động lực.",
    "Không khẳng định mọi người đều phản ứng giống nhau khi phần thưởng không xuất hiện.",
    "Không bảo đảm temptation bundling có cùng hiệu quả với tất cả mọi người.",
    "Không khẳng định nỗ lực luôn tạo ra niềm vui hoặc kết quả tích cực.",
