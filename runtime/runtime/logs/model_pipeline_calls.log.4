SOURCE:
{
  "audience_moment": "職場や病院、集合住宅の廊下で、手すりに手を添えながら歩き、「一人で歩けない自分は弱い」と感じる瞬間",
  "central_emotion": "恥ずかしさ",
  "core_self_insight": "支えを使うことは、自分の力のなさの証明ではなく、状況に応じて適応するための選択になり得る",
  "source_person": "Ann S. Masten",
  "source_work": "Ordinary magic: Resilience processes in development",
  "source_concept": "レジリエンスを、特別な精神力ではなく、環境との相互作用の中で生じる普通の適応過程として捉える視点",
  "verified_sources": [
    {
      "title": "Ordinary magic: Resilience processes in development",
      "url": "https://doi.org/10.1037/0003-066X.56.3.227",
      "supports": "Masten frames resilience as ordinary adaptive processes rather than a rare superpower, while emphasizing that outcomes depend on developmental and environmental conditions."
    },
    {
      "title": "Risk, resilience, and recovery: Perspectives from the Kauai Longitudinal Study",
      "url": "https://doi.org/10.1017/s095457940000612x",
      "supports": "Werner's longitudinal work describes resilience and recovery in the Kauai study and the role of supportive relationships and meaningful responsibilities; it does not establish a single cause."
    },
    {
      "title": "Annual Research Review: Positive adjustment to adversity - trajectories of minimal-impact resilience and emergent resilience",
      "url": "https://doi.org/10.1111/jcpp.12021",
      "supports": "Bonanno and colleagues review resilience trajectories and emphasize that positive adjustment can follow different paths; resilience should not be reduced to emotional toughness or one fixed trait."
    },
    {
      "title": "Learned helplessness at fifty: Insights from neuroscience",
      "url": "https://doi.org/10.1037/rev0000033",
      "supports": "Maier and Seligman review how uncontrollable stress can suppress later escape behavior and distinguish learned control from a deterministic helplessness explanation."
    }
  ],
  "allowed_paraphrases": [
    "回復力は特別な才能ではなく、複数の普通の適応過程から生まれることがあります",
    "環境と発達の条件を無視して、個人の強さだけに還元しません",
    "支えてくれる大人や意味のある役割は、適応を支える要素になり得ます",
    "長期的な適応には複数の保護要因が関わります",
    "回復には複数の軌跡があり、柔軟な適応として捉える必要があります",
    "強さを感情が揺れないことと同一視しません",
    "経験したコントロールの有無は、その後の反応に影響する可能性があります",
    "無力さを性格の欠陥として決めつけず、状況と学習の影響を分けて考えます"
  ],
  "long_form_revelations": [
    {
      "insight": "手すりのような支えを使うことは、特別な才能の不足を示すのではなく、環境に合わせた普通の適応の一つとして捉えられます。",
      "source_anchor": "回復力は特別な才能ではなく、複数の普通の適応過程から生まれることがあります",
      "boundary": "支えを使えば必ず回復できる、または誰もが同じ方法で適応できるという意味ではありません。"
    },
    {
      "insight": "人が立ち直る過程には、本人の意志だけでなく、支えてくれる関係や意味のある役割など、複数の要素が関わり得ます。",
      "source_anchor": "支えてくれる大人や意味のある役割は、適応を支える要素になり得ます",
      "boundary": "一人の支援者や一つの関係があれば、必ず回復するという約束にはしません。"
    },
    {
      "insight": "強さの形は一つではなく、すぐに揺れないことだけでなく、揺れながら環境に合わせて進むことも適応の一部になり得ます。",
      "source_anchor": "回復には複数の軌跡があり、柔軟な適応として捉える必要があります",
      "boundary": "誰もが同じ期間で回復する、または感情の揺れが少ないほど強いという評価には結びつけません。"
    },
    {
      "insight": "助けを求めにくくなる反応は、性格の欠陥と決めつけるより、過去にコントロールできなかった経験や状況の影響を分けて考える余地があります。",
      "source_anchor": "無力さを性格の欠陥として決めつけず、状況と学習の影響を分けて考えます",
      "boundary": "すべての停止反応や心理的な不調を、学習された無力さだけで説明したり診断したりしません。"
    }
  ],
  "forbidden_attributions": [
