{
  "audience_moment": "努力を続けて成果も出ているのに、スマートフォンの通知や新しい情報を何度も確認してしまい、達成感がすぐ消えると感じる場面",
  "central_emotion": "空虚感",
  "core_self_insight": "満たされなさは努力不足の証拠とは限らず、予測される報酬を追う習慣と、自分が認めにくい欲求や価値観が分離しているサインとして捉え直せる",
  "source_person": "Wolfram Schultz、Wendy Wood、C. G. Jung ほか",
  "source_work": "A Neural Substrate of Prediction and Reward、Psychology of Habit、Aion ほか",
  "source_concept": "報酬予測誤差、習慣、努力の価値、シャドウ、個性化",
  "verified_sources": [
    {
      "title": "A Neural Substrate of Prediction and Reward",
      "url": "https://doi.org/10.1126/science.275.5306.1593",
      "supports": "Schultz and colleagues reported dopamine-neuron responses related to reward prediction and prediction error in primates; this is not a complete theory of human motivation."
    },
    {
      "title": "Psychology of Habit",
      "url": "https://doi.org/10.1146/annurev-psych-122414-033417",
      "supports": "Wood and Runger review habits as learned responses shaped by repetition and context, with behavior becoming less dependent on deliberative intention in stable contexts."
    },
    {
      "title": "The Effort Paradox: Effort Is Both Costly and Valued",
      "url": "https://doi.org/10.1016/j.tics.2018.01.007",
      "supports": "Inzlicht and colleagues review evidence that effort can be experienced as costly while also being valued in some contexts; effort is not uniformly aversive or rewarding."
    },
    {
      "title": "The Collected Works of C. G. Jung, Vol. 9 Part 2: Aion — Researches into the Phenomenology of the Self",
      "url": "https://doi.org/10.1515/9781400851058",
      "supports": "Jung develops the shadow (シャドウ) and the Self as symbolic structures of the psyche, framed as an interpretive lens for self-integration rather than a clinical diagnosis."
    },
    {
      "title": "The Collected Works of C. G. Jung, Vol. 9 Part 1: The Archetypes and the Collective Unconscious",
      "url": "https://doi.org/10.1515/9781400850969",
      "supports": "Jung describes individuation (個性化), archetypes, and the collective unconscious as an interpretive framework for psychological development, not as empirically proven mechanisms."
    }
  ],
  "allowed_paraphrases": [
    "脳は報酬そのものだけでなく、予測とのずれにも反応します",
    "習慣は意志の強さだけでなく、反復と状況の手がかりによって形成されます",
    "環境を変えることは、行動のきっかけを変える方法の一つです",
    "努力は負担であると同時に、状況によって価値を持つことがあります",
    "難しさを感じることだけで、その行動が無価値だとは言えません",
    "シャドウとは、自分が認めにくい側面を象徴的に指す言葉として用います",
    "自己統合は、否認していた部分を意識に含めていく象徴的な過程として語られます",
    "個性化とは、無意識の側面を意識に統合していく過程として語られます"
  ],
  "long_form_revelations": [
    {
      "insight": "通知を確認しても満足が長続きしないとき、問題は単純な意志の弱さではなく、得られるはずの報酬と実際の結果のずれを繰り返し追っている状態として考えられる",
      "source_anchor": "脳は報酬そのものだけでなく、予測とのずれにも反応します",
      "boundary": "この研究は霊長類のドーパミン神経活動と報酬予測・予測誤差に関するものであり、個人の通知習慣や人間の動機全体を直接説明するものではない"
    },
    {
      "insight": "通知の確認が自動化しているように感じられるなら、行動を毎回意志で選んでいるというより、通知音や画面表示のような状況の手がかりと反復によって習慣化した反応を見直す必要がある",
      "source_anchor": "習慣は意志の強さだけでなく、反復と状況の手がかりによって形成されます",
      "boundary": "習慣研究から、すべての通知行動が同じ仕組みで形成された、または環境を変えれば必ず解決するとは言えない"
    },
    {
      "insight": "努力しても満たされないことは、努力そのものに価値がないという意味ではない。努力は負担になり得る一方、目的や文脈によっては価値あるものとして経験される",
      "source_anchor": "努力は負担であると同時に、状況によって価値を持つことがあります",
      "boundary": "努力すれば必ず満足できる、または努力を選ばない人を怠け者と評価する根拠にはならない"
    },
    {
      "insight": "ユング心理学のシャドウという枠組みでは、通知を追い続ける自分を排除すべき欠陥と決めつけず、自分が認めにくい欲求や側面が象徴的に表れている可能性を眺める",
      "source_anchor": "シャドウとは、自分が認めにくい側面を象徴的に指す言葉として用います",
      "boundary": "シャドウは解釈のための象徴的な概念であり、通知行動の原因や医学的症状を診断するものではない"
    },
    {
      "insight": "個性化という見方では、成果を出す自分だけを本当の自分とせず、休みたい、認められたい、別のことを試したいといった認めにくい側面も含めて、現在の努力の意味を問い直していく",
      "source_anchor": "個性化とは、無意識の側面を意識に統合していく過程として語られます",
      "boundary": "個性化や集合的無意識は心理体験を解釈する枠組みであり、科学的に証明された因果や特定の視聴者の過去を断定するものではない"
    }
  ],
  "forbidden_attributions": [
    "ドーパミンを快楽物質とだけ説明すること",
    "通知を確認する行動を、この研究だけで個人のやる気や習慣として断定すること",
    "通知が必ず脳の報酬系を依存状態にするという断定",
    "努力すれば必ず満たされる、または満たされない人は努力不足だという断定",
    "努力を選ばない人を怠け者と決めつけること",
    "シャドウ統合が特定の症状を必ず治すという断定",
    "ユング理論を科学的に証明された事実として断定すること",
    "視聴者個人の幼少期トラウマ、人格、精神疾患や診断を決めつけること",
    "象徴的な解釈を医学的診断として提示すること"
  ],
  "editorial_application": "「消えない通知」を、報酬の予測を追う仕組み、反復と環境手がかりによる習慣、努力の価値が文脈で変わること、そしてユングのシャドウという象徴的な見方を順に重ねて解説する。科学研究が扱う範囲と、ユング心理学を用いたチャンネル独自の解釈を明確に分ける。視聴者には通知を完全に断つ方法を約束せず、通知音や表示などの手がかりを観察し、自分が認めにくい欲求や努力の目的を言語化するための問いとして提示する",
  "overlap_with_recent_videos": "recent_videosとrecent_titlesが空で、比較可能な過去動画データはありません。したがって、既存動画との重複は判定不能です",
