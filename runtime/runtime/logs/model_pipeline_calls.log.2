  "core_question": "なぜこの人は、自分が本当に悪かったのかを確かめる前に、自分の感情と意思を玄関の外へ置くように謝ってしまうのか",
  "hook_draft": "玄関の前で、誰も押していないのに、先にドアを開けて「すみません」と言ってしまう。",
  "retention_blueprint": [
    {
      "kind": "revelation_progression",
      "payoff": "なぜこの人は、自分が本当に悪かったのかを確かめる前に、自分の感情と意思を玄関の外へ置くように謝ってしまうのか"
    }
  ],
  "sections": [
    {
      "id": "S2",
      "phase": "REFRAME_QUESTION",
      "segment_function": "reframe_question",
      "psychological_job": "自己非難を心理的な問いへ置き換える",
      "behavior_link": "自分の落ち度が不明でも責任を引き受ける",
      "why_answered": "守ろうとしている関係のために、何を自分から外へ出しているのか",
      "viewer_question_answered": "守ろうとしている関係のために、何を自分から外へ出しているのか",
      "mechanisms_used": [],
      "example_budget": 0,
      "new_information": "この反応は、優しさの証明でも弱さの証明でもなく、自分の感情を扱う前に関係を守ろうとする構えかもしれない",
      "state_advance": "behavior is only a personal flaw -> この反応は、優しさの証明でも弱さの証明でもなく、自分の感情を扱う前に関係を守ろうとする構えかもしれない",
      "so_what_next": "認めにくい感情をシャドウのレンズで見る",
      "relative_weight": 1.0
    }
  ],
  "planning_quality_gate": {
    "no_duplicate_sections": true,
    "every_section_advances_state": true,
    "psychology_is_spine": true,
