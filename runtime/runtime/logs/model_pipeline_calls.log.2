SOURCE:
{
  "audience_moment": "つらさや不安を感じているのに、誰かに「大丈夫？」と聞かれると、反射的に「大丈夫」と答えてしまう場面",
  "central_emotion": "疲労",
  "core_self_insight": "「大丈夫」と言い続けることは、必ずしも本当に平気だという意味ではなく、認めにくい自分の側面を意識から遠ざけるための象徴的な仮面になっている可能性がある",
  "source_person": "C. G. Jung",
  "source_work": "The Collected Works of C. G. Jung, Vol. 9 Part 1: The Archetypes and the Collective Unconscious／Vol. 9 Part 2: Aion",
  "source_concept": "個性化、シャドウ、自己統合",
  "verified_sources": [
    {
      "title": "The Collected Works of C. G. Jung, Vol. 9 Part 1: The Archetypes and the Collective Unconscious",
      "url": "https://doi.org/10.1515/9781400850969",
      "supports": "Jung describes individuation (個性化), archetypes, and the collective unconscious as an interpretive framework for psychological development, not as empirically proven mechanisms."
    },
    {
      "title": "The Collected Works of C. G. Jung, Vol. 9 Part 2: Aion — Researches into the Phenomenology of the Self",
      "url": "https://doi.org/10.1515/9781400851058",
      "supports": "Jung develops the shadow (シャドウ) and the Self as symbolic structures of the psyche, framed as an interpretive lens for self-integration rather than a clinical diagnosis."
    },
    {
      "title": "Annual Research Review: Positive adjustment to adversity - trajectories of minimal-impact resilience and emergent resilience",
      "url": "https://doi.org/10.1111/jcpp.12021",
      "supports": "Bonanno and colleagues review resilience trajectories and emphasize that positive adjustment can follow different paths; resilience should not be reduced to emotional toughness or one fixed trait."
    },
    {
      "title": "Learned helplessness at fifty: Insights from neuroscience",
      "url": "https://doi.org/10.1037/rev0000033",
      "supports": "Maier and Seligman review how uncontrollable stress can suppress later escape behavior and distinguish learned control from a deterministic helplessness explanation."
    }
  ],
  "allowed_paraphrases": [
    "個性化とは、無意識の側面を意識に統合していく過程として語られます",
    "元型や集合的無意識は、体験を解釈するための枠組みとして用います（証明された因果ではありません）",
    "シャドウとは、自分が認めにくい側面を象徴的に指す言葉として用います",
    "自己統合は、否認していた部分を意識に含めていく象徴的な過程として語られます",
    "回復には複数の軌跡があり、柔軟な適応として捉える必要があります",
    "強さを感情が揺れないことと同一視しません",
    "経験したコントロールの有無は、その後の反応に影響する可能性があります",
    "無力さを性格の欠陥として決めつけず、状況と学習の影響を分けて考えます"
  ],
  "long_form_revelations": [
    {
      "insight": "「大丈夫」という言葉を、本人の本心を直接証明する発言ではなく、現在の体験を守るための象徴的な仮面として読み替える。ただし、これは視聴者個人の無意識を断定することではない",
      "source_anchor": "Jung develops the shadow (シャドウ) and the Self as symbolic structures of the psyche, framed as an interpretive lens for self-integration rather than a clinical diagnosis.",
      "boundary": "「大丈夫」と言う人が必ず苦しみを隠している、あるいは特定のトラウマを持つとは言えない"
    },
    {
      "insight": "仮面にひびが入る瞬間を、弱さの証明ではなく、これまで意識から遠ざけていた感情や欲求に気づく入口として描く。ユング心理学では、個性化は無意識の側面を意識に統合していく過程として語られる",
      "source_anchor": "個性化とは、無意識の側面を意識に統合していく過程として語られます",
      "boundary": "個性化や自己統合は象徴的な解釈枠組みであり、症状を治す医学的プロセスとして提示しない"
    },
    {
      "insight": "シャドウを「悪い自分」ではなく、自分が認めにくい側面を指す象徴として扱う。「助けてほしい」「休みたい」「怒っている」といった可能性を、断定せずに自己観察の問いへ変える",
      "source_anchor": "シャドウとは、自分が認めにくい側面を象徴的に指す言葉として用います",
      "boundary": "視聴者の具体的な感情、人格、診断をシャドウという概念だけで決めつけない"
    },
    {
      "insight": "「平気なふり」を強さそのものと同一視しない。心理学的なレジリエンスには複数の軌跡があり、感情が揺れないことだけを回復や強さの基準にはできない",
      "source_anchor": "回復には複数の軌跡があり、柔軟な適応として捉える必要があります",
      "boundary": "誰もが同じ道筋で回復する、または弱さを見せれば必ず回復するとは約束しない"
    },
    {
      "insight": "長く「大丈夫」と言い続ける反応を、性格の欠陥と決めつけず、これまでどの程度コントロールを経験できたかという状況や学習の影響からも考える。ここでは無意識の真実を証明するのではなく、別の見方を提示する",
      "source_anchor": "無力さを性格の欠陥として決めつけず、状況と学習の影響を分けて考えます",
      "boundary": "この研究だけで、すべての停止反応、抑うつ、対人反応を説明したり、視聴者を無力だと判断したりしない"
    }
  ],
  "forbidden_attributions": [
