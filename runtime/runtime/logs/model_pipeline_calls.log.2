SOURCE:
{
  "audience_moment": "SNSや職場で、身近な人の昇進・受賞・恋愛・成功を見た瞬間、素直に祝えず、胸が苦しくなったとき",
  "central_emotion": "嫉妬",
  "core_self_insight": "他人の成功への苦しさは、相手だけへの評価ではなく、自分が認めにくい願望や可能性に触れた反応として読み解ける場合がある",
  "source_person": "C. G. Jung",
  "source_work": "The Collected Works of C. G. Jung, Vol. 9 Part 2: Aion — Researches into the Phenomenology of the Self",
  "source_concept": "シャドウと自己統合",
  "verified_sources": [
    {
      "title": "The Collected Works of C. G. Jung, Vol. 9 Part 2: Aion — Researches into the Phenomenology of the Self",
      "url": "https://doi.org/10.1515/9781400851058",
      "supports": "Jung develops the shadow (シャドウ) and the Self as symbolic structures of the psyche, framed as an interpretive lens for self-integration rather than a clinical diagnosis."
    },
    {
      "title": "The Collected Works of C. G. Jung, Vol. 9 Part 1: The Archetypes and the Collective Unconscious",
      "url": "https://doi.org/10.1515/9781400850969",
      "supports": "Jung describes individuation (個性化), archetypes, and the collective unconscious as an interpretive framework for psychological development, not as empirically proven mechanisms."
    }
  ],
  "allowed_paraphrases": [
    "シャドウとは、自分が認めにくい側面を象徴的に指す言葉として用います",
    "自己統合は、否認していた部分を意識に含めていく象徴的な過程として語られます",
    "個性化とは、無意識の側面を意識に統合していく過程として語られます",
    "元型や集合的無意識は、体験を解釈するための枠組みとして用います（証明された因果ではありません）"
  ],
  "long_form_revelations": [
    {
      "insight": "他人の成功を見たときに生じる嫉妬は、相手の欠点を発見した証拠ではなく、自分が認めにくい側面、たとえば『自分も挑戦したかった』という可能性に触れたと解釈できる場合がある",
      "source_anchor": "シャドウとは、自分が認めにくい側面を象徴的に指す言葉として用います",
      "boundary": "すべての嫉妬が隠れた願望を意味するとは断定せず、ユング的な象徴解釈の一つとして提示する"
    },
    {
      "insight": "成功した相手を『窓辺から見る』という比喩は、自分の内側にある願望を直接見る代わりに、他人の姿を通して見ている状態として扱える",
      "source_anchor": "個性化とは、無意識の側面を意識に統合していく過程として語られます",
      "boundary": "『窓辺』はチャンネルによる編集上の比喩であり、ユングの原文にある概念や科学的な心理メカニズムとして扱わない"
    },
    {
      "insight": "嫉妬をただ消そうとするより、その感情が示している自分の認めにくい側面を意識に含めることが、自己統合を考える入口になり得る",
      "source_anchor": "自己統合は、否認していた部分を意識に含めていく象徴的な過程として語られます",
      "boundary": "自己統合によって嫉妬や特定の症状が必ず解消するとは述べない"
    },
    {
      "insight": "他人の成功は、自分の価値が下がったという事実ではなく、自分がどのような生き方を意識から遠ざけているのかを考えるきっかけとして再解釈できる",
      "source_anchor": "元型や集合的無意識は、体験を解釈するための枠組みとして用います（証明された因果ではありません）",
      "boundary": "この再解釈を客観的事実や個人の内面を確定する診断として提示しない"
    },
    {
      "insight": "相手を引き下ろしたくなる衝動と、自分も何かを望んでいる可能性を同時に見つめることで、嫉妬を道徳的な自己否定だけで終わらせず、自分との対話に変えられる",
      "source_anchor": "個性化とは、無意識の側面を意識に統合していく過程として語られます",
      "boundary": "嫉妬を行動に移すことを正当化せず、他人への攻撃や比較を推奨しない"
    }
  ],
  "forbidden_attributions": [
    "ユング理論を科学的に証明された事実として断定すること",
    "嫉妬する人には必ず同じ隠れた願望やシャドウがあると一般化すること",
    "他人の成功への苦しさを、劣等感・トラウマ・病気・人格障害などの診断として決めつけること",
    "シャドウ統合が嫉妬や特定の症状を必ず治すと断定すること",
    "『窓辺』をユング本人の用語や原典の比喩として引用すること",
    "他人の成功は自分の価値を下げる、または成功者には嫉妬される理由があると断定すること",
    "象徴的な解釈を医学的診断や治療法として提示すること"
  ],
