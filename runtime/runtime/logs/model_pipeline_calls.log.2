  "core_question": "なぜこの人は、相手を助けたいからではなく、断りたい気持ちを認めることへの罪悪感によって、同じ引き受け方を繰り返してしまうのか？",
  "hook_draft": "あなたにも、心当たりはないでしょうか。「大丈夫です」と笑ったあと、誰もいない場所で、指先だけがゆっくり固くなる。",
  "retention_blueprint": [
    {
      "kind": "revelation_progression",
      "payoff": "なぜこの人は、相手を助けたいからではなく、断りたい気持ちを認めることへの罪悪感によって、同じ引き受け方を繰り返してしまうのか？"
    }
  ],
  "sections": [
    {
      "id": "S4",
      "phase": "CONSEQUENCE",
      "segment_function": "integration",
      "psychological_job": "パターンの機能と代償を同時に示し、単純な『やめるべき行動』にしない。",
      "behavior_link": "相手を失望させないために引き受け、後から不満を抱えること。",
      "why_answered": "この行動は私を何から守り、何を失わせているのか？",
      "viewer_question_answered": "この行動は私を何から守り、何を失わせているのか？",
      "mechanisms_used": [
        "シャドウと自己統合"
      ],
      "example_budget": 1,
      "new_information": "引き受けることは関係の摩擦を避ける機能を持ちうる一方、自分の疲労や拒否を後回しにし、内側の怒りを蓄積させる。",
      "state_advance": "behavior is only a personal flaw -> 引き受けることは関係の摩擦を避ける機能を持ちうる一方、自分の疲労や拒否を後回しにし、内側の怒りを蓄積させる。",
      "so_what_next": "葛藤の少なさと善良さを混同しない視点へ進む。",
      "relative_weight": 1.0
    }
  ],
  "planning_quality_gate": {
    "no_duplicate_sections": true,
    "every_section_advances_state": true,
    "psychology_is_spine": true,
    "no_plot_or_character_arc": true,
    "ending_creates_self_understanding": true
  },
  "commitments": [
    {
      "type": "enumeration",
      "label": "enumeration",
      "count": 7,
      "items": [
        "笑顔で返事をした後にも、罪悪感・疲労・怒りが同時に残るサイン",
        "拒否や怒りを認めにくいことで、善良な自己像を守ろうとするサイン",
        "反復と状況の手がかりによって、熟考せず引き受ける応答になるサイン",
        "過去にコントロールできなかった経験が、後の選択に影響するサイン",
        "関係の摩擦を避ける一方で、疲労や拒否を後回しにし、怒りを蓄積させるサイン",
        "助けた後の葛藤が、親切の偽物ではなく、選択前に自分の欲求を確認していなかった可能性を示すサイン",
        "『いい人』であるために消していた部分も、自分の全体の一部として見つめられるサイン"
      ],
      "sections": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6",
        "S7"
      ],
      "number_framing": "exact"
    },
    {
      "type": "enumeration",
      "label": "enumeration",
      "count": 2,
      "items": [
        "反復と状況の手がかりが、行動を熟考への依存が少ない応答にする可能性",
        "過去にコントロールできなかった経験が、後の選択に影響する可能性"
      ],
      "sections": [
        "S3"
      ],
      "number_framing": "exact"
    }
  ]
}
