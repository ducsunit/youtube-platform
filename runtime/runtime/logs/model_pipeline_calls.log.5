imary_narration\": \"direct psychological explanation / analysis\",\n    \"secondary_device\": \"behavioral examples used only for recognition and evidence\",\n    \"forbidden_spine\": [\n      \"narrative story\",\n      \"personal anecdote\",\n      \"cinematic monologue\",\n      \"fictional character journey\",\n      \"chronological life story\",\n      \"scene-to-scene progression\"\n    ]\n  },\n  \"content_spine\": {\n    \"psychological_pattern\": \"通知や未読表示を見たとき、返信したい意図を確認する前に、開くことや返信を後回しにする行動が起こりやすくなるパターン\",\n    \"core_question\": \"返信したい気持ちがあるのに、なぜ開くという最初の行動だけを避けてしまうのか\",\n    \"central_mechanism\": \"通知やメッセージという状況の手がかりと、返信に伴う負担を避ける反応が反復によって結びつき、熟考した返信意図への依存が小さい行動が起こりやすくなること\",\n    \"causal_logic\": \"通知や未読表示が返信を求められる状況の手がかりになると、開く前から負担が始まるように感じられる。その負担を避けるためにアプリを閉じたり、あとで返すと判断したりする反応が起こり、同じ流れが繰り返されることで、似た手がかりに対して先延ばしが起こりやすくなる\",\n    \"viewer_self_understanding\": \"自分は返信したくない、冷たい、怠けていると決めつけるのではなく、メッセージを開く場面で負担回避の反応が繰り返されている可能性を観察できる\"\n  },\n  \"recognition_device\": {\n    \"behavioral_signals\": [\n      \"通知の内容を見ただけで緊張し、アプリを開く前に閉じる\",\n      \"返信したい相手からのメッセージほど、開く判断を後回しにする\",\n      \"返信文を考える前に「あとで返す」と決める\",\n      \"未読や通知の表示を気にしながら、メッセージそのものには触れない\",\n      \"返信できていないことを意識すると、自分を意志が弱いと評価する\"\n    ],\n    \"micro_examples\": [\n      \"通知を確認した瞬間に、返信するか考える前に画面を閉じる\",\n      \"開けばすぐ返せる短いメッセージでも、まず時間を置こうとする\",\n      \"何度も通知を確認しながら、開くことだけを後回しにする\"\n    ],\n    \"usage_rule\": \"examples identify the viewer's pattern; they must never carry the narrative progression\"\n  },\n  \"packaging_layer\": {\n    \"title_question\": \"返したいのに、なぜメッセージを開くことさえ避けてしまうのか\",\n    \"thumbnail_question\": \"開くだけなのに、なぜ重い？\",\n    \"curiosity_gap\": \"返信したくないのではなく、メッセージを開いた瞬間に負担が始まるように感じるため、意思より先に回避が起こる可能性\",\n    \"packaging_must_not_become_content_spine\": true\n  },\n  \"spine_hierarchy\": [\n    \"psychological pattern\",\n    \"why it happens\",\n    \"inner process / mechanism\",\n    \"behavioral manifestation\",\n    \"example as evidence\",\n    \"reframe / self-understanding\"\n  ],\n  \"thumbnail_brief\": {\n    \"click_question\": \"返したいのに、なぜ開けない？\",\n    \"visual_conflict\": \"返信したい気持ちと、通知画面を閉じる行動の対比\",\n    \"title_must_not_repeat\": \"メッセージを開けない理由という文字列をそのまま繰り返さず、負担や迷いの感覚で補完する\"\n  }\n}\nPSYCHOLOGY BRIEF:\n{\n  \"psychological_identity\": \"返信したい意図がある一方で、通知や未読表示をきっかけに、開いた直後の負担を避ける反応が起こりやすくなっている心理的パターン\",\n  \"core_psychological_question\": \"なぜ返信したいと思っているのに、メッセージを開くという最初の行動を避ける反応が繰り返されるのか\",\n  \"main_tension\": \"返したいという意図は存在しているのに、メッセージを開いた瞬間から返信を考えなければならないように感じられ、その負担を避ける行動が意図より先に起こる\",\n  \"route\": \"PROCESS\",\n  \"selected_mechanisms\": [\n    {\n      \"name\": \"状況の手がかりに基づく習慣化\"\n    }\n  ]\n}\nADAPTIVE PLAN:\n{\n  \"route\": \"PROCESS\",\n  \"core_question\": \"返信したい気持ちがあるのに、なぜメッセージを開くという最初の行動だけを避けてしまうのか\",\n  \"retention_blueprint\": [\n    {\n      \"movement\": \"cold_open\",\n      \"new_information\": \"返信したい意図があるのに、通知を見た時点で開かずに閉じるという矛盾を提示する。\",\n      \"stay_reason\": \"自分の冷たさや意志の弱さではなく、別の行動パターンかもしれないという疑問が残る。\",\n      \"psychological_progress\": \"行動の自己評価から、行動の仕組みへの観察へ視点を移す。\"\n    },\n    {\n      \"movement\": \"misconception_reframe\",\n      \"new_information\": \"問題の中心は返信への意思の欠如ではなく、開くことと負担を感じることの結びつきである可能性を示す。\",\n      \"stay_reason\": \"返信したい気持ちと先延ばしが同時に存在できる理由を知りたくなる。\",\n      \"psychological_progress\": \"矛盾した性格という理解から、反復する状況反応という理解へ進む。\"\n    },\n    {\n      \"movement\": \"mechanism\",\n      \"new_information\": \"反復と状況の手がかりによって、通知に対して熟考した意図より先に反応が起こりやすくなる仕組みを説明する。\",\n      \"stay_reason\": \"通知を見るだけで回避が始まるように感じる理由が具体化される。\",\n      \"psychological_progress\": \"自分で毎回選んでいるという感覚から、手がかりに反応する学習された行動として理解する。\"\n    },\n    {\n      \"movement\": \"inner_process\",\n      \"new_information\": \"通知が返信要求の手がかりになり、開く前から負担へ注意が向き、アプリを閉じる判断が先に起こる流れを示す。\",\n      \"stay_reason\": \"先延ばしによって何が変わり、何が残るのかを自分の感覚と照らし合わせられる。\",\n      \"psychological_progress\": \"単なる先送りという見え方から、負担を避ける反応と未完了感が並ぶプロセスへ進む。\"\n    },\n    {\n      \"movement\": \"practical_shift\",\n      \"new_information\": \"意志を強くするより、返信を完了させる条件ではなく、開くという最初の行動の条件を小さく調整する原則を提示する。\",\n      \"stay_reason\": \"自分を責めずに、手がかりと最初の行動の結びつきを観察する方法がわかる。\",\n      \"psychological_progress\": \"意志で押し切る発想から、行動のきっかけを扱う発想へ進む。\"\n    },\n    {\n      \"movement\": \"quiet_landing\",\n      \"new_information\": \"先延ばしを、返信したくない証拠ではなく、特定の場面で負担回避が先に起こる可能性として見直す。\",\n      \"stay_reason\": \"自分への決めつけを弱め、次の通知で反応を観察できる余白が残る。\",\n      \"psychological_progress\": \"自己否定から、反復するパターンを見分ける自己理解へ到達する。\"\n    }\n  ],\n  \"continuity_map\": {\n    \"big_open_loop\": \"返信したいのに、なぜメッセージを開くという最初の行動だけを避けてしまうのか。\",\n    \"payoff_path\": [\n      \"返信への意思があっても、通知と負担回避の反応が結びつくと、意思を確認する前に先延ばしが起こりやすくなる。\",\n      \"その反応は、通知という手がかり、負担への注意、アプリを閉じる行動という流れとして観察できる。\",\n      \"変える出発点は意志の強化ではなく、開くという最初の行動にかかる条件を小さく調整することにある。\"\n    ],\n    \"retention_turns\": [\n      {\n        \"after_section\": \"S2\",\n        \"new_information\": \"返信したくないのではなく、開くことが返信の負担の開始として感じられている可能性を示す。\",\n        \"why_continue\": \"この感覚が、どのように通知への反応として固定されるのかを知りたくなる。\"\n      },\n      {\n        \"after_section\": \"S3\",\n        \"new_information\": \"習慣は反復と状況の手がかりによって形成され、安定した状況では熟考した意図への依存が小さくなるという枠組みを当てはめる。\",\n        \"why_continue\": \"通知を見た瞬間の注意と回避が、どのような内的な流れを作るのかが次の焦点になる。\"\n      },\n      {\n        \"after_section\": \"S4\",\n        \"new_information\": \"閉じることでその場の負担から距離を取れても、未完了の返信と次に戻る負担は残りうるという観察可能なコストを示す。\",\n        \"why_continue\": \"自分を責めずに、この行動パターンの入口をどう扱えるかへ進める。\"\n      }\n    ]\n  },\n  \"sections\": [\n    {\n      \"id\": \"S1\",\n      \"purpose\": \"返したいのに開けないという行動を短く認識させ、性格評価ではなく心理的パターンの問題として見る入口を作る。\",\n      \"psychological_job\": \"通知を見た直後に閉じる、あとで返すと決める、未読を気にしながら開かないという共通パターンを一般化する。\",\n      \"behavior_link\": \"返信したい相手からの通知ほど、返信を考える前にアプリを閉じたり、開く判断を後回しにしたりする。\",\n      \"relative_weight\": 0.9,\n      \"why_answered\": \"視聴者が自分の行動を認識し、今回扱う心理的な矛盾を正確に捉えられるため。\",\n      \"mechanisms_used\": [],\n      \"example_budget\": 1,\n      \"optional_reason\": \"core\",\n      \"new_information\": \"返信したい意図と、メッセージを開かない行動は同時に存在しうる。開いた瞬間から返事を考えなければならないように感じると、意思を確認する前に負担回避が起こる可能性がある。\",\n      \"viewer_question_answered\": \"自分は本当に返信したくないのか、それとも別の反応が先に起きているのか。\",\n      \"state_advance\": \"開かない自分は冷たいか意志が弱いと思っている -> 返信したい意図とは別に、開く場面で負担を避ける反応が起きている可能性に気づく\",\n      \"so_what_next\": \"では、なぜその反応は返信したいという意図より先に起こるのでしょうか。\",\n      \"segment_function\": \"recognition\"\n    },\n    {\n      \"id\": \"S2\",\n      \"purpose\": \"返信拒否や怠慢という思い込みを外し、中心となる心理的な問いを明確にする。\",\n      \"psychological_job\": \"行動の意味を性格や相手への気持ちから切り離し、状況と負担の結びつきへ焦点を移す。\",\n      \"behavior_link\": \"短い返信で済みそうな内容でも、開けば返事を考えることになると感じて、まず時間を置こうとする。\",\n      \"relative_weight\": 1.0,\n      \"why_answered\": \"自己否定を止めるだけでなく、動画全体を引っ張る問いを心理的な形に整えるため。\",\n      \"mechanisms_used\": [],\n      \"example_budget\": 0,\n      \"optional_reason\": \"core\",\n      \"new_information\": \"中心にあるのは返信への意思の欠如とは限らない。メッセージを開くという状況の手がかりと、返信に伴う負担を避ける反応が結びついている可能性がある。これは性格の分類ではなく、反復された行動パターンとして観察できる。\",\n      \"viewer_question_answered\": \"返信したい気持ちがあるのに、なぜ開くことだけが重くなるのか。\",\n      \"state_advance\": \"先延ばしは返信したくない気持ちの表れだと考えている -> 返信への意思があっても、開くことが負担の手がかりになりうると理解する\",\n      \"so_what_next\": \"この結びつきを説明する鍵が、状況の手がかりに基づく習慣化です。\",\n      \"segment_function\": \"misconception_reframe\"\n    },\n    {\n      \"id\": \"S3\",\n      \"purpose\": \"選択された唯一のメカニズムを使い、通知に対する反応が意思より先に起こりうる理由を説明する。\",\n      \"psychological_job\": \"反復、状況の手がかり、熟考した意図への依存の小ささを、返信の場面に限定してつなぐ。\",\n      \"behavior_link\": \"通知を見る、開く、返信を考える、負担を感じて閉じるという流れが似た状況で繰り返されると、次の通知でも先延ばしが起こりやすくなる。\",\n      \"relative_weight\": 1.35,\n      \"why_answered\": \"なぜ毎回ゼロから判断している感覚が薄く、同じ場面で似た反応が出るのかを説明できるため。\",\n      \"mechanisms_used\": [\n        \"状況の手がかりに基づく習慣化\"\n      ],\n      \"example_budget\": 0,\n      \"optional_reason\": \"core\",\n      \"new_information\": \"WoodとRungerのレビューでは、習慣は反復と状況によって形成される学習された反応として扱われ、安定した状況では行動が熟考した意図に依存しにくくなると説明されている。この動画で通知と先延ばしを結びつける部分は、個人の性格や診断を示すものではなく、その考え方を返信場面に当てはめた限定的な解釈である。\",\n      \"viewer_question_answered\": \"通知を見たとき、返信したいかを考える前に先延ばしが起こりやすくなるのはなぜか。\",\n      \"state_advance\": \"自分が毎回意志で返信を避けていると思っている -> 反復された状況の手がかりが、熟考より先に行動を呼び起こしうると理解する\",\n      \"so_what_next\": \"仕組みをさらに細かく見ると、通知から回避までの間に何へ注意が向いているかが見えてきます。\",\n      \"segment_function\": \"mechanism\"\n    },\n    {\n      \"id\": \"S4\",\n      \"purpose\": \"通知を見た瞬間の内的プロセスと、先延ばしによって残る観察可能なコストを示す。\",\n      \"psychological_job\": \"手がかり、注意、反応、未完了感の順に、因果を断定しすぎず行動の流れとして整理する。\",\n      \"behavior_link\": \"未読表示を何度も確認しながら、メッセージそのものには触れず、返信文を考える前に「あとで返す」と判断する。\",\n      \"relative_weight\": 1.25,\n      \"why_answered\": \"先延ばしを単純な怠慢ではなく、負担に注意が向いた結果として自己観察できるため。\",\n      \"mechanisms_used\": [\n        \"状況の手がかりに基づく習慣化\"\n      ],\n      \"example_budget\": 1,\n      \"optional_reason\": \"required by brief\",\n      \"new_information\": \"通知や未読表示が返信を求められる状況の手がかりになると、「開いたら返事を考えなければならない」という負担へ注意が向きやすい。そこでアプリを閉じる、または後回しにすると、メッセージ自体は未完了のまま残り、返信の遅延や戻るときの重さを観察できる。\",\n      \"viewer_question_answered\": \"先延ばしの直前には、心の中で何が起きているのか。\",\n      \"state_advance\": \"先延ばしは理由のない怠慢に見えている -> 通知が負担への注意を引き、返信を考える前の回避判断につながる流れとして観察できる\",\n      \"so_what_next\": \"だから変える対象は、意志そのものではなく、最初の行動が起こる条件です。\",\n      \"segment_function\": \"inner_world\"\n    },\n    {\n      \"id\": \"S5\",\n      \"purpose\": \"状況の手がかりを扱う実践原則を、返信全体ではなく開くという入口に限定して提示する。\",\n      \"psychological_job\": \"意志を強くする努力から、最初の行動にかかる条件を小さく調整する視点へ移す。\",\n      \"behavior_link\": \"通知を見た瞬間に返信の完成までを想像する代わりに、開くことだけを一つの行動として扱い、必要なら通知の見え方や確認する場面を変える。\",\n      \"relative_weight\": 1.05,\n      \"why_answered\": \"メカニズムに沿った実践として、自己否定を減らしながら行動の入口を観察できるため。\",\n      \"mechanisms_used\": [\n        \"状況の手がかりに基づく習慣化\"\n      ],\n      \"example_budget\": 0,\n      \"optional_reason\": \"useful\",\n      \"new_information\": \"原則は、返信を一度に終わらせようとせず、開くという最初の行動が起こりやすい条件を整えること。具体的には、通知を見たときに「返す」ではなく「開く」だけを区切る、返信を考える時間と通知を確認する場面を分ける、同じ手がかりで閉じる前に一度だけ反応を観察する、という最大三つの小さな調整が使える。\",\n      \"viewer_question_answered\": \"意志の強さを責める代わりに、どこを見直せばよいのか。\",\n      \"state_advance\": \"返信できる自分になるには気合いが必要だと思っている -> 行動のきっかけと最初の一歩の条件を調整するほうが、パターンを観察しやすいと理解する\",\n      \"so_what_next\": \"それでも毎回すぐ変わる必要はなく、まず次の通知で自分の反応を見分けます。\",\n      \"segment_function\": \"practical_shift\"\n    },\n    {\n      \"id\": \"S6\",\n      \"purpose\": \"自己理解へ静かに着地し、パターンと人格を切り分ける。\",\n      \"psychological_job\": \"返信の遅れを相手への気持ちや人格の証拠として決めつけず、反復する反応として捉え直す。\",\n      \"behavior_link\": \"次に通知を見たとき、返信したいかどうかを裁く前に、開くことのどの部分で負担が立ち上がったかを観察する。\",\n      \"relative_weight\": 0.8,\n      \"why_answered\": \"動画の約束である自己否定から自己観察への移行を完成させるため。\",\n      \"mechanisms_used\": [],\n      \"example_budget\": 0,\n      \"optional_reason\": \"core\",\n      \"new_information\": \"メッセージを開けないことは、返信したくない、冷たい、怠けているという一つの結論を意味しない。反復と状況の手がかりによって、負担回避の反応が先に起こっている可能性を見つけられる。\",\n      \"viewer_question_answered\": \"この行動を、これから自分についてどう理解すればよいのか。\",\n      \"state_advance\": \"返信の遅れを自分の性格や気持ちの問題として決めつけている -> 通知という手がかりに対する反応パターンとして観察し、自分への判断を少し保留できる\",\n      \"so_what_next\": \"返信したいのに開けない自分を責める前に、まず負担が始まる入口を見つけてください。\",\n      \"segment_function\": \"insight_landing\"\n    }\n  ],\n  \"redundancy_risks\": [\n    \"S1とS2で「返信したいのに開けない」という対比を繰り返しすぎない。S1は認識、S2は性格評価から状況反応への転換に限定する。\",\n    \"S3では反復と状況の手がかりによる習慣化だけを説明し、S4の内的プロセスを先取りしない。\",\n    \"S4では短期的な負担回避が反応を維持すると断定せず、未完了感や返信遅延という観察可能なコストに限定する。\",\n    \"S5の実践は一般的な生産性向上のリストにせず、開くという最初の行動の条件を調整する原則に統一する。\",\n    \"S6では内容を要約し直さず、人格評価と行動パターンを切り分ける一つの自己理解で終える。\"\n  ],\n  \"hook_draft\": \"返したいのに、メッセージを開けない。通知を見た瞬間、返信するか考える前に画面を閉じて、「あとで返そう」と決めてしまう。返したくないわけではないのに、開いた瞬間から返事を考えなければならないようで、負担だけが先に始まるからです。では、なぜ返信したいという意図より先に、開かない反応が起こるのでしょうか。中心にあるのは、意志の弱さではなく、通知と負担を避ける反応が結びついた行動パターンかもしれません。\",\n  \"cta_plan\": \"もし思い当たるなら、次の通知で自分を責める前に、開く直前にどんな負担を感じたのかを一度だけ観察してみてください。\",\n  \"planning_quality_gate\": {\n    \"no_duplicate_sections\": true,\n    \"every_section_advances_state\": true,\n    \"psychology_is_spine\": true,\n    \"no_plot_or_character_arc\": true,\n    \"ending_creates_self_understanding\": true,\n    \"each_section_answers_one_psychological_question\": true,\n    \"examples_are_evidence_not_spine\": true,\n    \"mechanism_is_argument_core\": true,\n    \"recognition_does_not_become_scene_progression\": true\n  }\n}\nSOURCE PACK:\n{\n  \"audience_moment\": \"返信したいメッセージを通知で見かけても、開くと返事を求められる気がして、あとで返そうと先延ばしする場面\",\n  \"central_emotion\": \"不安\",\n  \"core_self_insight\": \"返事を先延ばししてしまうのは、意志が弱いからと決めつけられるものではなく、メッセージを開くことと負担を感じることが結びつき、状況に反応する行動パターンが固定されている可能性がある\",\n  \"source_person\": \"Wendy Wood・Dennis Runger\",\n  \"source_work\": \"Psychology of Habit\",\n  \"source_concept\": \"習慣は反復と状況の手がかりによって形成され、安定した状況では熟考した意図への依存が小さくなる学習された反応\",\n  \"verified_sources\": [\n    {\n      \"title\": \"Psychology of Habit\",\n      \"url\": \"https://doi.org/10.1146/annurev-psych-122414-033417\",\n      \"supports\": \"Wood and Runger review habits as learned responses shaped by repetition and context, with behavior becoming less dependent on deliberative intention in stable contexts.\"\n    }\n  ],\n  \"allowed_paraphrases\": [\n    \"習慣は意志の強さだけでなく、反復と状況の手がかりによって形成されます\",\n    \"環境を変えることは、行動のきっかけを変える方法の一つです\"\n  ],\n  \"forbidden_attributions\": [\n    \"習慣が必ず一定日数で自動化するという断定\",\n    \"環境設計だけですべての心理的問題が解決するという主張\"\n  ],\n  \"editorial_application\": \"通知を見る、メッセージを開く、返信を考える、負担を感じて閉じるという流れが繰り返されると、次に似た通知を見たときにも同じ先延ばしが起こりやすくなる、という形で解説する。ただし、これは視聴者の性格や診断を決める説明ではなく、反復と状況の手がかりから行動を捉え直すための編集上の解釈として扱う。冒頭では「返したいのに、開けない」という具体的な行動と、「返信したくないのではなく、開いた瞬間に負担が始まるように感じる」という対比を先に提示する。\",\n  \"overlap_with_recent_videos\": \"最近の動画と同じく、人との関わりや感情の調整に伴う負担を扱うが、今回は対人関係の距離や帰宅後の消耗ではなく、メッセージを開かず返信を先延ばしする行動ループと習慣形成に焦点を置く。\",\n  \"claim_ledger\": {\n    \"version\": 2,\n    \"authority\": \"locked_source_pack\",\n    \"allowed_claims\": [\n      {\n        \"id\": \"source_concept\",\n        \"claim\": \"習慣は反復と状況の手がかりによって形成され、安定した状況では熟考した意図への依存が小さくなる学習された反応\",\n        \"support\": \"source_pack.source_concept\",\n        \"usage\": \"May name or explain this concept within the verified support.\"\n      },\n      {\n        \"id\": \"paraphrase_01\",\n        \"claim\": \"習慣は意志の強さだけでなく、反復と状況の手がかりによって形成されます\",\n        \"support\": \"source_pack.allowed_paraphrases\",\n        \"usage\": \"May be paraphrased without increasing causal certainty.\"\n      },\n      {\n        \"id\": \"paraphrase_02\",\n        \"claim\": \"環境を変えることは、行動のきっかけを変える方法の一つです\",\n        \"support\": \"source_pack.allowed_paraphrases\",\n        \"usage\": \"May be paraphrased without increasing causal certainty.\"\n      },\n      {\n        \"id\": \"verified_source_01\",\n        \"claim\": \"Wood and Runger review habits as learned responses shaped by repetition and context, with behavior becoming less dependent on deliberative intention in stable contexts.\",\n        \"support\": \"https://doi.org/10.1146/annurev-psych-122414-033417\",\n        \"usage\": \"Use only at the level expressed in this support statement.\"\n      }\n    ],\n    \"editorial_application\": {\n      \"text\": \"通知を見る、メッセージを開く、返信を考える、負担を感じて閉じるという流れが繰り返されると、次に似た通知を見たときにも同じ先延ばしが起こりやすくなる、という形で解説する。ただし、これは視聴者の性格や診断を決める説明ではなく、反復と状況の手がかりから行動を捉え直すための編集上の解釈として扱う。冒頭では「返したいのに、開けない」という具体的な行動と、「返信したくないのではなく、開いた瞬間に負担が始まるように感じる」という対比を先に提示する。\",\n      \"rule\": \"May be used as a bounded interpretive lens, never as a separately proven causal mechanism.\"\n    },\n    \"forbidden_terms\": [\n      \"アドラー心理学\",\n      \"スキーマ療法\",\n      \"トラウマ反応\",\n      \"ポリヴェーガル理論\",\n      \"愛着理論\",\n      \"環境設計だけですべての心理的問題が解決するという主張\",\n      \"習慣が必ず一定日数で自動化するという断定\",\n      \"認知行動療法\",\n      \"課題の分離\"\n    ],\n    \"forbidden_claim_categories\": [\n      \"named framework or author absent from this run's sources\",\n      \"causal mechanism beyond the stated support\",\n      \"diagnosis, childhood cause, trauma cause, or neuroscience claim without support\"\n    ],\n    \"capabilities\": {\n      \"reinforcement_loop\": false\n    }\n  }\n}\n\n内部で一度だけeditorial self-checkを行ってください：\n(1) psychological spineを一文で確認する。\n(2) 各sectionが「何を起こすか」ではなく「何を理解させるか」を確認する。\n(3) recognitionを短く書き、すぐmisconception / WHYへ移す。\n(3a) title_hook_contract の opening_anchors の少なくとも一つを最初の20秒相当のopeningに自然に置き、titleが約束したbehavior/painを先に返す。title全文の繰り返しや抽象的な背景説明にはしない。\n(4) mechanismごとに behavior → interpretation → inner process → consequence の因果を埋める。\n(5) story化した箇所を behavior observation / micro-example → mechanism explanation に変換する。\n(6) exampleを全部削除しても心理的な論旨が成立するか確認する。成立しない場合は書き直す。\n(7) 最後にpsychological insightがviewerのself-understandingへ着地しているか確認する。\n(8) hookのopen loopが、source-backed mechanismまたは観察可能なcostで回収されているか確認する。\n(9) VIDEO-10 QUALITY BAR: 各段落が一つだけ新しい理解を渡し、mechanism 1 と mechanism 2 が\n同じ説明を繰り返していないか確認する。二つ目が不要またはsource外なら作らない。costは観察可能な\n入口の負担として書き、sourceがない限り安心・回避による強化ループとして断定しない。\n\n【SOURCE-BOUNDARY FOR PARADOX】\nSOURCE PACK の claim_ledger.capabilities.reinforcement_loop が false の場合、「一時的な安心や\n苦痛の低下が反応を強化・維持する」という因果は書かないでください。未完了が残る、次に戻る時に\n重く感じられる、という観察可能なcostは書けますが、それをreinforcement mechanismとして断定しません。\n\n【最終セルフチェック】\n- 各sectionはpsychological_jobを果たしているか。\n- exampleがなくてもargumentが成立するか。\n- scene → action → emotion → next scene の連鎖がないか。\n- 時系列で出来事を進めていないか。\n- 「なぜその行動が起きるのか」の説明が場面描写より多いか。\n- viewerが「自分はこういう人間だから」ではなく「自分の中でこういうprocessが起きていた」と理解できるか。\n\n条件: target_char_min〜target_char_maxは契約上の互換レンジです。実際の目安は\n6〜12分、380〜400 CPM換算で約2,300〜4,800文字です。argumentとsourceが本当に十分な場合だけ\n15分程度（約6,000文字）まで許容します。これはquotaではありません。各movementに新しい理解がある場合だけ\n展開し、同じreframeの言い換えで文字数を埋めないでください。Markdown見出しなし、引用捏造なし、本人語りなし。\n診断、generic self-help、concept overload、trauma-by-defaultを避ける。{ANTI_STORY_RULES}"}, {"role": "assistant", "content": "返したいのに、メッセージを開けない。通知を見た瞬間、返信するか考える前に画面を閉じて、「あとで返そう」と決めてしまう。未読の表示は気になるのに、メッセージそのものには触れない。短い返事で済みそうな内容ほど、なぜか開く判断を後回しにする。返したくないわけではないのに、開いた瞬間から返事を考えなければならないようで、負担だけが先に始まるからです。なぜ返信したいという意図より先に、開かない反応が起こるのでしょうか。\n\nこの行動を、相手を大切にしていない証拠や、意志が弱くて怠けている証拠だと考えることがあります。けれど、返信したい気持ちがあることと、メッセージを開けないことは、同時に起こりえます。\n\n中心にあるのは、返信への意思の欠如とは限りません。メッセージを開くことと、その直後に感じる負担を避ける反応が結びついている可能性があります。つまり、相手への気持ちを判断する前に、特定の場面で特定の反応が先に起きている。ここで見たいのは、あなたがどんな人間かではなく、開くという行動の直前に何が起きているかです。\n\nたとえば、通知の内容を見ただけで緊張し、アプリを開かずに閉じる。返信文を考える前に「あとで返す」と決める。何度も通知を確認しているのに、開くことだけを先送りする。これは、返信したくない人の行動と決めつけるより、開く場面で負担を避ける反応が起きやすくなっている状態として見たほうが、実際の矛盾を説明しやすくなります。\n\nこの結びつきを考える鍵が、状況の手がかりに基づく習慣化です。\n\n習慣は、意志の強さだけでできるものではありません。反復と状況の手がかりによって、ある場面である反応が起こりやすくなる、学習された行動でもあります。WoodとRungerのレビューでも、習慣は反復された状況と結びついて形成され、状況が安定していると、行動はその都度じっくり考えた意図に頼らず起こりやすくなると説明されています。\n\nこれを返信の場面に当てはめると、通知を見ることが、単なる情報の確認ではなく、「返信を求められる状況」の手がかりになっている可能性があります。通知が表示される。メッセージを開く。返事を考える。うまく言葉を選ばなければならない、すぐに返さなければならない、相手の反応まで考えなければならない。そうした負担が、開く前からひとまとまりに感じられる。\n\nすると、返信したいかどうかを落ち着いて判断する前に、注意が「返事をしなければならない」という重さへ向かいます。行動の入口は、返信という目的ではなく、その負担から距離を取ることになります。アプリを閉じる。「あとで返す」と判断する。別の画面を見る。こうした反応は、長い考えの結果として選ばれているというより、通知という手がかりに対して、これまで繰り返されてきた流れが先に出ていると考えられます。\n\nここで重要なのは、返信したい意図が消えたわけではないことです。意図はあっても、通知を見たときに起こる反応のほうが先に動くことがある。だから本人の中では、「返したいのに返せない」「返せるはずなのに開けない」という矛盾として感じられます。\n\n自分では、毎回ちゃんと考えてから返信を避けているつもりかもしれません。しかし、似た状況が何度も繰り返されると、通知を見た瞬間に同じ判断へ向かいやすくなります。返信するかどうかを検討する前に、「今はやめておこう」が出てくる。これは、返信への意図を否定する性格の特徴ではなく、状況の手がかりと行動の流れが結びついた結果として観察できます。\n\n通知を見た直後の内側では、まずメッセージの内容よりも、「開いたら返事を考えなければならない」という感覚に注意が向いていることがあります。実際の文章を読む前から、返信の難しさや未完了の負担が予測される。すると、開くことが情報を得る動作ではなく、返事を始める合図のように感じられます。\n\nだから、まだ返信文を一文字も考えていないのに、「あとで返す」と決める。まだ相手から催促されていないのに、返答を求められているように感じる。返事の内容ではなく、開いた後に続くはずの負担を先に受け取っている状態です。\n\nこのとき画面を閉じれば、少なくともその場ではメッセージに向き合う必要がなくなります。ただし、メッセージが消えるわけではありません。未読の表示や返信できていない事実は残り、次に確認するときには、前よりも「まだ返していない」という未完了感を伴うことがあります。何度も通知を気にしながら開けないのは、返信を終えたい気持ちと、開くことで始まる負担を避けたい反応が、同じ画面の前で並んでいるからです。\n\nここでも、先延ばしを意志の弱さだけで説明すると、見えている流れが抜け落ちます。意志があるかないかを裁く前に、通知が何を意味する手がかりになっているのか、開く直前に何へ注意が向いているのかを見る必要があります。\n\n変える出発点も、返信を最後まで終わらせるために気合いを入れることではありません。開くという最初の行動が起こる条件を、小さく扱うことです。\n\n通知を見たとき、「返さなければ」と一気に考える代わりに、「今は開くところまで」と区切る。返信を考える時間と、通知を確認する場面を同じものにしない。あるいは、画面を閉じる前に、開くことのどの部分が重く感じられたのかを一度だけ確認する。大きく返信の習慣を変えようとするのではなく、通知という手がかりから、回避へ向かう最初の流れを見えるようにします。\n\nこれは、環境を変えればすべてが解決するという話ではありません。通知の見え方や確認する場面を調整することは、行動のきっかけを変える方法の一つにすぎません。大切なのは、自分にもっと強い意志を要求することではなく、どの条件で「開く」と「負担」が結びついているのかを確かめることです。\n\n次に通知を見たとき、返信したいかどうかをすぐに裁く必要はありません。まず、開く前に負担が始まっていないかを見てください。メッセージを開けないことは、返信したくない、冷たい、怠けているという一つの結論ではありません。特定の手がかりに対して、負担を避ける反応が先に起こっている可能性を見つけられる、ということです。"}, {"role": "user", "content": "Đây là lượt hoàn thiện cuối trong cùng một phiên viết kịch bản.\nGiữ nguyên contract, plan và source ở message đầu tiên.\nREVIEWER FINDINGS:\n{\n  \"decision\": \"revise\",\n  \"optimization_report\": \"最大の弱点は、唯一のメカニズムである「状況の手がかりに基づく習慣化」が、S3からS4にかけて同じ意味で何度も説明され、内的プロセスとコストの焦点がぼやけていたことです。反復と手がかりによる反応形成の説明を一度に集約し、その後は「開く前に負担へ注意が向く」という内的プロセスと、未完了感という観察可能なコストに進む形へ整理しました。\",\n  \"score_report\": null,\n  \"psychology_scorecard\": null,\n  \"revised_draft_clean\": \"返したいのに、メッセージを開けない。通知を見た瞬間、返信するか考える前に画面を閉じて、「あとで返そう」と決めてしまう。未読の表示は気になるのに、メッセージそのものには触れない。短い返事で済みそうな内容ほど、開く判断を後回しにすることもあります。\\n\\n返したくないわけではないのに、開いた瞬間から返事を考えなければならないようで、負担だけが先に始まる。なぜ返信したいという意図より先に、開かない反応が起こるのでしょうか。\\n\\nこの行動を、相手を大切にしていない証拠や、意志が弱くて怠けている証拠だと考えることがあります。けれど、返信したい気持ちがあることと、メッセージを開けないことは、同時に起こりえます。\\n\\n中心にあるのは、返信への意思の欠如とは限りません。メッセージを開くことと、その直後に感じる負担を避ける反応が結びついている可能性があります。ここで見たいのは、あなたがどんな人間かではなく、開くという行動の直前に何が起きているかです。\\n\\nこの結びつきを考える鍵が、状況の手がかりに基づく習慣化です。習慣は、意志の強さだけでできるものではありません。反復と状況の手がかりによって、ある場面である反応が起こりやすくなる、学習された行動でもあります。\\n\\nWoodとRungerのレビューでは、習慣は反復された状況と結びついて形成され、状況が安定していると、行動はその都度じっくり考えた意図に頼らず起こりやすくなると説明されています。これを返信の場面に限定して考えると、通知が「返信を求められる状況」の手がかりになり、開く前から負担を感じる流れが繰り返されている可能性があります。\\n\\n通知が表示される。開く。返事を考える。うまく言葉を選ばなければならない、すぐに返さなければならない、と感じる。そのまとまりが重くなると、返信したいかどうかを落ち着いて判断する前に、「今はやめておこう」が出てきます。アプリを閉じる、あとで返すと決める、別の画面を見る。これまで似た状況で繰り返された反応が、通知という手がかりに対して先に出ていると考えられます。\\n\\nつまり、意図が消えたわけではありません。意図があっても、通知を見たときの反応が先に動くことがある。だから本人の中では、「返したいのに返せない」「返せるはずなのに開けない」という矛盾として感じられます。\\n\\n通知を見た直後は、メッセージの内容よりも、「開いたら返事を考えなければならない」という感覚に注意が向いていることがあります。実際の文章を読む前から、返信の難しさや未完了の負担を予測してしまう。すると、開くことが情報を得る動作ではなく、返事を始める合図のように感じられます。\\n\\nだから、まだ返信文を一文字も考えていないのに、「あとで返す」と決める。画面を閉じれば、その場ではメッセージに向き合わずに済みます。ただし、未読の表示や返信できていない事実は残ります。次に確認するとき、「まだ返していない」という未完了感が加わることもあります。ここに、負担を避けた直後の楽さと、後に残る重さの並びが見えてきます。\\n\\n変える出発点は、返信を最後まで終わらせるために気合いを入れることではありません。開くという最初の行動が起こる条件を、小さく扱うことです。\\n\\n通知を見たとき、「返さなければ」と一気に考える代わりに、「今は開くところまで」と区切る。返信を考える時間と、通知を確認する場面を同じものにしない。画面を閉じる前に、開くことのどの部分が重く感じられたのかを一度だけ確認する。大きく返信の習慣を変えようとするのではなく、通知という手がかりから回避へ向かう最初の流れを見えるようにします。\\n\\n次に通知を見たとき、返信したいかどうかをすぐに裁く必要はありません。メッセージを開けないことは、返信したくない、冷たい、怠けているという一つの結論ではなく、負担を避ける反応が先に起こる場面として観察できます。思い当たるなら、開く直前に何が重くなったのかを一度だけ見てみてください。\",\n  \"revised_draft_vi\": \"Điểm yếu lớn nhất của bản nháp là cơ chế “thói quen dựa trên tín hiệu tình huống” được giải thích lặp lại nhiều lần. Bản sửa đã gom phần giải thích về sự lặp lại và tín hiệu vào một đoạn, sau đó chuyển rõ sang quá trình chú ý đến gánh nặng trước khi mở tin nhắn, chi phí là cảm giác chưa hoàn tất, rồi mới đến nguyên tắc thực hành.\\n\\nBản Nhật đã cắt các đoạn lặp ý nhưng giữ nguyên hành vi nhận diện, câu hỏi tâm lý trung tâm, cơ chế, nguồn Wood và Runger, nguyên tắc điều chỉnh điều kiện để mở tin nhắn, cùng phần kết yên tĩnh.\",\n  \"tts_tag_anchors\": [],\n  \"restructure_map\": \"Gộp phần giải thích cơ chế từ các đoạn giữa bài thành một lần duy nhất: từ sự lặp lại và tín hiệu thông báo dẫn đến phản ứng trì hoãn. Sau đó tách rõ ba bước tiếp theo: chú ý chuyển sang gánh nặng trước khi mở, chi phí là cảm giác chưa hoàn tất, và thực hành chỉ nhắm vào điều kiện của hành động đầu tiên là mở tin nhắn.\",\n  \"cut_list\": [\n    \"「たとえば、通知の内容を見ただけで緊張し、アプリを開かずに閉じる。返信文を考える前に『あとで返す』と決める。何度も通知を確認しているのに、開くことだけを先送りする。」— S1の行動例が冒頭の認識と重複するため削除。\",\n    \"「ここでも、先延ばしを意志の弱さだけで説明すると、見えている流れが抜け落ちます。意志があるかないかを裁く前に…」— 直前のメカニズム説明と同じリフレームのため削除。\",\n    \"「自分では、毎回ちゃんと考えてから返信を避けているつもりかもしれません…」— 反復と手がかりが意図より先に働く説明の重複として削除。\",\n    \"「これは、環境を変えればすべてが解決するという話ではありません…」— スコープが明確になった後の一般的な免責であり、実践原則に新情報を加えないため削除。\",\n    \"「メッセージを開けないことは…可能性を見つけられる、ということです。」— Endingで同じリフレームを長く繰り返していたため、観察への着地を短く統合。\"\n  ],\n  \"title_thumbnail_advisory\": {\n    \"title_candidates\": [\n      \"返したいのにメッセージを開けない理由\",\n      \"返信したいのに開けない行動が続く理由\",\n      \"メッセージを開くほど返信が重くなる理由\"\n    ],\n    \"thumbnail_lines\": [\n      \"開くだけなのに、なぜ重い？\",\n      \"返したいのに開けない？\"\n    ],\n    \"thumbnail_prompt\": \"通知画面を閉じようとする手と、返信したい