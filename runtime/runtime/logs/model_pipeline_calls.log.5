    "secondary_device": "behavioral examples used only for recognition and evidence",
    "forbidden_spine": [
      "narrative story",
      "personal anecdote",
      "cinematic monologue",
      "fictional character journey",
      "chronological life story",
      "scene-to-scene progression"
    ]
  },
  "content_spine": {
    "psychological_pattern": "休みたいと思っているのに、予定のない時間でも通知確認、家事、勉強、予定確認などの対応行動を探し続ける行動傾向。",
    "core_question": "なぜ休息の意図があっても、何もしない状態より何かに対応している状態のほうが自然に感じられるのか。",
    "central_mechanism": "習慣と状況の手がかり。反復された行動は、特定の状況や環境に触れたとき、毎回意識的に判断しなくても立ち上がりやすくなることがあります。",
    "causal_logic": "通知、仕事用の机、未完了の家事などが対応行動と結びついた手がかりになると、休息中でも注意が対応対象へ向きやすくなる可能性があります。その結果、何もしない状態に落ち着かなさを感じ、確認・整理・着手を始める行動パターンが現れます。これは研究から個別の因果関係が証明されたという意味ではなく、習慣と状況の手がかりを休日の休息へ適用した編集上の解釈として扱います。",
    "viewer_self_understanding": "「休めない自分は怠けている」と評価する前に、どの状況の手がかりが自分を対応行動へ向かわせているのかを観察できる。通知を切る、仕事道具を視界から外す、休む場所を決めるなど、環境の手がかりを調整することは、行動のきっかけを変える一つの方法として考えられる。"
  },
  "recognition_device": {
    "behavioral_signals": [
      "予定のない休日でも、連絡や通知を何度も確認する",
      "休もうとすると、未完了の家事や勉強を探して始める",
      "仕事用の机や道具が視界に入ると、対応すべきことを考え始める",
      "何もしない時間に、休むより先に次の行動を決めようとする",
      "休んでいる最中も、予定やタスクを頭の中で繰り返し確認する"
    ],
    "micro_examples": [
      "スマートフォンを手元に置いたまま休もうとして、数分おきに通知を確認する",
      "家事を終えた直後でも、別の未完了作業を探して動き始める",
      "仕事道具が目に入った瞬間に、休む前に処理すべきことを考える",
      "何もしない時間を過ごすために、まず休息の予定や手順を決めようとする"
    ],
    "usage_rule": "examples identify the viewer's pattern; they must never carry the narrative progression"
  },
  "packaging_layer": {
    "title_question": "なぜ、予定がないのに何もしないで休めないのか？",
    "thumbnail_question": "休みなのに落ち着かない？",
    "curiosity_gap": "怠慢や意志力不足ではなく、反復された行動と状況の手がかりが休息中の注意を動かしている可能性を示す。",
    "packaging_must_not_become_content_spine": true
  },
  "spine_hierarchy": [
    "psychological pattern",
    "why it happens",
    "inner process / mechanism",
    "behavioral manifestation",
    "example as evidence",
    "reframe / self-understanding"
  ],
  "thumbnail_brief": {
