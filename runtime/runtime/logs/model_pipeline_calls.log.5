{
  "audience_moment": "自分で選べるはずなのに、進路・仕事・予定などの返事を誰かに決めてもらうまで動けないとき",
  "central_emotion": "不安",
  "core_self_insight": "決められないのは意志が弱いからとは限らず、自分で決めた結果を引き受けることへの不安や、過去に自分の選択では状況を変えられなかった経験が影響している可能性がある",
  "source_person": "Steven F. Maier・Martin E. P. Seligman",
  "source_work": "Learned helplessness at fifty: Insights from neuroscience",
  "source_concept": "学習されたコントロールと無力感",
  "verified_sources": [
    {
      "title": "Learned helplessness at fifty: Insights from neuroscience",
      "url": "https://doi.org/10.1037/rev0000033",
      "supports": "Maier and Seligman review how uncontrollable stress can suppress later escape behavior and distinguish learned control from a deterministic helplessness explanation."
    },
    {
      "title": "嫌われる勇気｜ダイヤモンド社",
      "url": "https://www.diamond.co.jp/book/9784478025819.html",
      "supports": "岸見一郎・古賀史健の共著情報と課題の分離を含む目次"
    }
  ],
  "allowed_paraphrases": [
    "経験したコントロールの有無は、その後の反応に影響する可能性があります",
    "無力さを性格の欠陥として決めつけず、状況と学習の影響を分けて考えます"
  ],
  "forbidden_attributions": [
    "すべての抑うつや停止反応をこの研究だけで説明すること",
    "逆境が必ず人を強くするという断定",
    "自分で決められない人を無力な人間だと決めつけること",
    "特定の視聴者に childhood trauma や診断を割り当てること"
  ],
  "editorial_application": "「誰かに決めてもらうまで動けない」状態を、怠けや性格の弱さではなく、選択の結果を自分だけで背負う不安と、過去の経験から形成されたコントロール感の問題として丁寧に説明する。誰かの意見を参考にすること自体は問題ではなく、最終的な選択を他者に預け続けることで一時的に不安が下がり、行動開始が遅れる流れを示す。改善策としては、人生全体の決断を急に自分だけで担うのではなく、「今日の夕食」「返信する時間」など結果の範囲が小さい選択から、自分の基準で決める練習を提案する。『嫌われる勇気』の課題の分離は、他者の期待と自分が決める範囲を整理する補助的な視点として扱い、学術研究そのものの結論とは混同しない。",
  "overlap_with_recent_videos": "最近の動画はいずれも、人と会うことや昔の友人との関係、帰宅後に動けなくなることなど、対人場面での疲労や感情調整を扱っている。本テーマも他者への過剰な適応や不安と接点があるが、中心を『人と会うと疲れる理由』ではなく、『自分の選択を他者に委ねるまで行動できない瞬間』に置くことで差別化できる。既存動画の長さが25分前後で視聴維持率が低かったため、具体的な日常場面から始める6〜12分程度の構成と相性がよい。",
  "claim_ledger": {
    "version": 2,
    "authority": "locked_source_pack",
    "allowed_claims": [
      {
        "id": "source_concept",
        "claim": "学習されたコントロールと無力感",
        "support": "source_pack.source_concept",
        "usage": "May name or explain this concept within the verified support."
      },
      {
        "id": "paraphrase_01",
        "claim": "経験したコントロールの有無は、その後の反応に影響する可能性があります",
        "support": "source_pack.allowed_paraphrases",
        "usage": "May be paraphrased without increasing causal certainty."
      },
      {
        "id": "paraphrase_02",
        "claim": "無力さを性格の欠陥として決めつけず、状況と学習の影響を分けて考えます",
        "support": "source_pack.allowed_paraphrases",
        "usage": "May be paraphrased without increasing causal certainty."
      },
