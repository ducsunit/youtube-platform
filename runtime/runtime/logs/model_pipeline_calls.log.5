{
  "audience_moment": "Khi người khác vừa đưa ra yêu cầu hoặc bày tỏ ý kiến trái chiều, bạn chưa kịp nói suy nghĩ của mình đã vội nói「すみません」và đồng ý.",
  "central_emotion": "Lo lắng",
  "core_self_insight": "Lời xin lỗi bật ra trước có thể là một phản ứng đã được học qua sự lặp lại trong những bối cảnh giao tiếp quen thuộc, không nhất thiết phản ánh rằng bạn thật sự có lỗi.",
  "source_person": "Wendy Wood và Dennis Runger",
  "source_work": "Psychology of Habit",
  "source_concept": "Thói quen như phản ứng được hình thành bởi sự lặp lại và dấu hiệu bối cảnh",
  "verified_sources": [
    {
      "title": "Psychology of Habit",
      "url": "https://doi.org/10.1146/annurev-psych-122414-033417",
      "supports": "Wood và Runger tổng quan rằng thói quen là những phản ứng được học qua sự lặp lại và bối cảnh; trong các bối cảnh ổn định, hành vi có thể ít phụ thuộc hơn vào ý định có chủ ý."
    }
  ],
  "allowed_paraphrases": [
    "習慣は意志の強さだけでなく、反復と状況の手がかりによって形成されます",
    "環境を変えることは、行動のきっかけを変える方法の一つです"
  ],
  "forbidden_attributions": [
    "習慣が必ず一定日数で自動化するという断定",
    "環境設計だけですべての心理的問題が解決するという主張"
  ],
