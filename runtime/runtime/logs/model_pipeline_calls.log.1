      },
      {
        "id": "paraphrase_02",
        "claim": "元型や集合的無意識は、体験を解釈するための枠組みとして用います（証明された因果ではありません）",
        "support": "source_pack.allowed_paraphrases",
        "usage": "May be paraphrased without increasing causal certainty."
      },
      {
        "id": "paraphrase_03",
        "claim": "シャドウとは、自分が認めにくい側面を象徴的に指す言葉として用います",
        "support": "source_pack.allowed_paraphrases",
        "usage": "May be paraphrased without increasing causal certainty."
      },
      {
