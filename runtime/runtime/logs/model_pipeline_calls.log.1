  "format_lock": {
    "primary_format": "psychological profile / psychological deep-dive",
    "content_center": "một psychological pattern hoặc kiểu người có pattern lặp lại — psychology là content spine",
    "primary_narration": "direct psychological explanation / analysis",
    "secondary_device": "behavioral examples used only for recognition and evidence",
    "forbidden_spine": [
      "narrative story",
      "personal anecdote",
      "cinematic monologue",
      "fictional character journey",
      "chronological life story",
      "scene-to-scene progression"
    ]
  },
  "content_spine": {
    "psychological_pattern": "Không từ chối sớm, liên tục nhận lời hoặc duy trì liên lạc vượt quá khả năng, rồi khi áp lực tích lũy quá lớn lại muốn rút khỏi toàn bộ kết nối.",
    "core_question": "Vì sao việc không nói rõ giới hạn từ đầu lại khiến phương án cắt toàn bộ liên lạc trở nên dễ hình dung hơn việc điều chỉnh từng mối liên hệ?",
    "central_mechanism": "課題の分離: tách phần mình có trách nhiệm quyết định và thực hiện khỏi kỳ vọng, phản ứng hoặc sự thất vọng thuộc về đối phương. 境界線の遅れ là cách gọi biên tập cho việc giới hạn chỉ được biểu đạt sau khi áp lực đã tích lũy.",
    "causal_logic": "Một yêu cầu xuất hiện, người này tập trung vào việc đối phương sẽ nghĩ gì nếu bị từ chối, rồi nhận lời trước khi kiểm tra khả năng thật của mình. Mỗi lần đồng ý giúp giảm lo lắng trong ngắn hạn nhưng mở rộng phần trách nhiệm phải duy trì. Khi nhiều yêu cầu chồng lên nhau, các liên lạc khác nhau bị cảm nhận như một nguồn áp lực duy nhất, khiến việc cắt toàn bộ trở thành cách nhanh nhất để lấy lại khoảng cách và quyền quyết định.",
    "viewer_self_understanding": "Mong muốn cắt liên lạc có thể là tín hiệu cho thấy giới hạn đã bị trì hoãn quá lâu, không phải bằng chứng chắc chắn rằng người xem lạnh lùng hay giả tạo. Tuy vậy, cách phản ứng này vẫn có thể gây gián đoạn quan hệ, nên trọng tâm là nhận diện điểm giới hạn sớm hơn và nói rõ phần mình có thể đảm nhận."
  },
  "recognition_device": {
    "behavioral_signals": [
      "Nhận lời giúp đỡ hoặc trả lời tin nhắn trước khi kiểm tra thời gian và năng lượng của mình.",
      "Dùng các câu mơ hồ như \"để xem\" hoặc \"chắc là được\" thay vì nói rõ phạm vi có thể đảm nhận.",
      "Tiếp tục phản hồi dù đã thấy nặng nề, bực bội hoặc không còn muốn tham gia.",
      "Xem kỳ vọng và sự thất vọng của đối phương như phần việc mình phải xử lý.",
      "Trì hoãn việc nói rằng mình không thể đáp ứng cho đến khi áp lực lấn át hoàn toàn.",
      "Khi quá tải, muốn ngừng trả lời hoặc cắt nhiều kênh liên lạc cùng lúc."
    ],
    "micro_examples": [
      "Một tin nhắn nhờ giúp được trả lời đồng ý trước khi người nhận kịp xem lại lịch của mình.",
      "Một lời mời không muốn nhận được đáp lại bằng câu trả lời mở, khiến đối phương tiếp tục chờ và kỳ vọng.",
      "Sau nhiều lần phản hồi miễn cưỡng, toàn bộ thông báo từ người đó bắt đầu được cảm nhận như một áp lực duy nhất.",
      "Thay vì nói \"lần này tôi không thể\", người này tưởng tượng đến việc chặn hoặc biến mất khỏi mọi kênh liên lạc."
    ],
    "usage_rule": "examples identify the viewer's pattern; they must never carry the narrative progression"
  },
  "packaging_layer": {
    "title_question": "なぜ「断れない人」は、少し距離を取るより先に、突然すべての連絡を切りたくなるのか？",
    "thumbnail_question": "なぜ、全部切りたくなる？",
    "curiosity_gap": "視聴者が冷たさや気まぐれだと思っている全遮断願望を、相手への拒絶ではなく、遅れて表面化した自己責任の範囲の回復として読み替える。",
    "packaging_must_not_become_content_spine": true
  },
  "spine_hierarchy": [
    "psychological pattern",
    "why it happens",
    "inner process / mechanism",
    "behavioral manifestation",
    "example as evidence",
    "reframe / self-understanding"
  ],
  "thumbnail_brief": {
    "click_question": "断れないのに、なぜ全部切る？",
    "visual_conflict": "「受け入れ続ける」ことと「突然すべて遮断する」ことを同じ画面上の対立として示す。",
    "title_must_not_repeat": "「境界線の遅れ」や「課題の分離」という答えをサムネイルで先に明示しない。"
  }
}
