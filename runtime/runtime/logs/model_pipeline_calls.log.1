  "core_self_insight": "帰宅後に動けない自分を怠けや意志の弱さと決めつける前に、仕事中に使った注意や判断の力、休息へ流れやすい状況の手がかり、行動開始時に感じる努力の負担が重なった結果として捉え直せる。",
  "central_emotion": "無力感",
  "psychological_identity": "仕事中に使った注意や判断の力が残る一方、帰宅後の環境には座る・休む方向へ移りやすい手がかりがあり、行動開始に伴う努力の負担も重なることで、意図よりも状況に沿った反応が選ばれやすくなる心理的パターン。",
  "core_psychological_question": "なぜ帰宅後にやることを理解していても、意志の弱さではなく、状況の手がかりと行動開始時の努力の負担によって、最初の一歩を選べなくなるのか。",
  "main_tension": "やるべきことは分かっているのに、行動を始めるための意図より、休息へ向かう環境の手がかりと努力を避けたい感覚のほうが、その場の行動を強く方向づけること。",
  "route": "PROCESS",
  "selected_mechanisms": [
    "状況の手がかりによる習慣化",
    "努力の負担と価値の評価",
    "自己コントロールを意志力だけで捉える誤り"
  ],
  "single_core_promise": "帰宅後に動けない反応を人格の欠陥ではなく、反復された状況の手がかりと行動開始の負担から理解し、自分がどこで止まりやすいのかを見直せるようにする。",
  "title_candidates": [
    {
      "title": "帰宅後に何も始められない人の心理的理由",
      "mechanism": "状況の手がかりによる習慣化と、行動開始時の努力の負担",
      "char_count": 19
    },
    {
      "title": "なぜ帰宅後は休むだけになるのか、その心理",
      "mechanism": "休息へ流れる環境の手がかりと、意図より反応が先に選ばれる過程",
      "char_count": 20
    },
    {
      "title": "意志が弱いからではない、帰宅後に動けない理由",
      "mechanism": "自己コントロールを意志力だけで捉える誤りと環境調整の見落とし",
      "char_count": 22
    }
  ],
  "chosen_title": "帰宅後に何も始められない人の心理的理由",
  "chosen_title_char_count": 19,
  "target_duration_minutes": "9-11",
  "target_char_min": 2400,
  "target_char_max": 4700,
  "hook_contract": {
    "recognition_by_seconds": 8,
    "misconception_or_tension_by_seconds": 18,
    "first_real_insight_by_seconds": 35,
    "core_question_by_seconds": 55
  },
  "format_lock": {
    "primary_format": "psychological profile / psychological deep-dive",
    "content_center": "帰宅後に休息へ流れ、予定した行動の開始地点を作れなくなる心理的パターンを分析する。心理学的説明を内容の中心に置く。",
    "primary_narration": "direct psychological explanation / analysis",
    "secondary_device": "behavioral examples used only for recognition and evidence",
    "forbidden_spine": [
      "narrative story",
      "personal anecdote",
      "cinematic monologue",
      "fictional character journey",
      "chronological life story",
      "scene-to-scene progression"
    ]
  },
  "content_spine": {
    "psychological_pattern": "帰宅をきっかけに、複数の用事から最初の一つを選べなくなり、休息や受動的な行動へ流れ続ける行動傾向。",
    "core_question": "やるべきことを理解しているのに、なぜ意図よりも休息へ向かう反応が先に選ばれるのか。",
    "central_mechanism": "帰宅後の環境と反復された行動の結びつきが休息方向の反応を呼び出し、同時に行動開始に必要な準備や判断が努力の負担として評価されること。",
    "causal_logic": "仕事や学校で注意と判断を使った状態で帰宅することで、複数の用事を整理して最初の行動を選ぶ負担が目立つ。そこに座る場所やスマートフォンなどの休息の手がかりが重なり、開始に必要な努力より短期的な軽さが選ばれやすくなる。座る反応が繰り返されるほど、帰宅と休息の流れが結びつきやすくなる。",
    "viewer_self_understanding": "動けない事実は消えなくても、それを意志の弱さだけで説明する必要はない。自分が止まる地点を、選択肢の多さ、開始準備の重さ、休息へ向かう手がかりのどこで生じているのかとして観察できる。"
  },
  "recognition_device": {
    "behavioral_signals": [
      "帰宅後、着替え・食事・入浴などの順番を決められず、座る行動だけを先に選ぶ",
      "予定していた勉強や家事を始める前に、スマートフォンや動画など受動的な行動へ移る",
      "必要な物を出す、場所を移動する、道具を準備する行動を後回しにする",
      "一つの用事だけでも負担に感じ、何から始めるかを考えるほど動きにくくなる",
      "休むつもりが長引き、後から自己嫌悪や無力感を覚える",
      "翌日も同じ流れを繰り返し、帰宅後の自分を意志が弱いと説明する"
    ],
    "micro_examples": [
      "着替える前に座った結果、入浴の準備まで先送りになる",
      "食事を作るための道具を出す前に、短い動画を一本だけ見るつもりで再生する",
      "勉強を始める前に机を整える必要があると考え、その準備自体を後回しにする",
      "帰宅後の用事を一度に思い浮かべ、最初の一つを選べないまま休息へ移る"
    ],
    "usage_rule": "examples identify the viewer's pattern; they must never carry the narrative progression"
  },
  "packaging_layer": {
    "title_question": "帰宅後に何も始められないのは、意志が弱いからなのか。",
    "thumbnail_question": "なぜ玄関で止まる？",
    "curiosity_gap": "視聴者は帰宅直後の停止を疲れや性格の問題と考えやすいが、実際には休息へ流れる手がかりと、開始時の努力の評価が行動を方向づけている可能性がある。",
    "packaging_must_not_become_content_spine": true
  },
  "spine_hierarchy": [
    "psychological pattern",
    "why it happens",
    "inner process / mechanism",
    "behavioral manifestation",
    "example as evidence",
    "reframe / self-understanding"
  ],
  "thumbnail_brief": {
    "click_question": "帰宅しただけで、なぜ動けなくなるのか？",
    "visual_conflict": "帰宅後にやることは分かっているのに、休息へ流れてしまう意図と反応のズレ",
    "title_must_not_repeat": "「帰宅後」「何も始められない」「心理的理由」をそのまま繰り返さない"
  }
